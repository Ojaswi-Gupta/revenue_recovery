# === Razorpay Test Mode ===
RAZORPAY_KEY_ID=eg
RAZORPAY_KEY_SECRET=eg

# === Groq API (Free Tier — no credit card) ===
GROQ_API_KEY=eg

# === Google Gemini API (Free Tier — fallback) ===
GEMINI_API_KEY=eg

# === Twilio (Optional — free trial) ===
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# === App Settings ===
DATABASE_URL=sqlite+aiosqlite:///./recovrai.db
APP_ENV=development
LOG_LEVEL=INFO

# === SMTP Email Configuration (Free: Gmail App Password or Resend/SendGrid) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="RecovrAI Accounts Receivable"
SMTP_USE_TLS=true
# === Public URL (Optional - ngrok) ===
APP_BASE_URL=
